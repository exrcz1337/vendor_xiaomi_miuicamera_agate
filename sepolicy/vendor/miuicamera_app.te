binder_use(miuicamera_app)
binder_call(miuicamera_app, hal_camera_default)
binder_call(miuicamera_app, hal_camerapostproc_xiaomi)

type miuicamera_app, domain, coredomain;

app_domain(miuicamera_app)
net_domain(miuicamera_app)

hal_client_domain(miuicamera_app, hal_misys)

allow miuicamera_app {
    app_api_service
    audioserver_service
    cameraserver_service
    mediaextractor_service
    mediametrics_service
    mediaserver_service
}:service_manager find;

dontaudit miuicamera_app radio_service:service_manager find;

allow miuicamera_app hal_camerapostproc_xiaomi_hwservice:hwservice_manager find;
allow miuicamera_app hal_misys_hwservice:hwservice_manager find;
allow miuicamera_app privapp_data_file:file execute;
allow miuicamera_app vendor_camera_data_file:dir { append map search r_dir_perms write };
allow miuicamera_app vendor_camera_data_file:file { create getattr open read write };

# Properties
get_prop(miuicamera_app, vendor_fingerprint_prop)
r_dir_file(miuicamera_app, vendor_configs_file)
allow miuicamera_app same_process_hal_file:file { execute read open getattr map };
get_prop(miuicamera_app, vendor_mtk_camera_prop)

# APU (NPU) access - camera AI engine (MACE/apusys) opens /dev/apusys directly.
# Without this: apusysSession_createInstance errno 13 -> APUSysEngine::createInstance()
# failed -> ParallelDataZip SIGSEGV (fault addr 0xe0/0x31).
allow miuicamera_app apusys_device:chr_file rw_file_perms;
allow miuicamera_app apusys_device:chr_file ioctl;

# bokeh kernel files dumped under /data/vendor/camera_dump
r_dir_file(miuicamera_app, vendor_camera_dump_file)
allow miuicamera_app ion_device:chr_file rw_file_perms;
allow miuicamera_app vendor_camera_dump_file:file { create write getattr open read };
