# Framework allowlists
persist.vendor.camera.privapp.list=com.android.camera
vendor.camera.aux.packagelist=com.android.camera,com.xiaomi.cameratest,com.xiaomi.factory.mmi,com.xiaomi.runin

# Google Lens
ro.com.google.lens.oem_camera_package=com.android.camera

# MiuiCamera
ro.miui.build.region=global
ro.miui.notch=1
ro.product.mod_device=agate_global
